# Basin — required environment variables
# Copy to .env and fill in. NEVER commit .env — this repo is public.

# Neon Postgres (system of record + Dagster instance storage)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudflare R2 (immutable raw source snapshots)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=basin-snapshots

# Modal (ensemble / parameter-sweep compute)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Optional — raises rate limits (instant self-serve signup)
USGS_API_KEY=

# Phase 2+
NASS_API_KEY=
NCEI_CDO_TOKEN=
